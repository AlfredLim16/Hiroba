# Hiroba Environment Configuration Template
# Copy this file to .env.local for local development or .env for production deployment.

APP_NAME=Hiroba
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/hiroba/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hiroba
DB_USER=root
DB_PASS=

SESSION_LIFETIME=1800
CSRF_EXPIRY=3600
COOKIE_SECURE=false
